SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Required for POST /entries to bypass RLS. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=3000

# Shared secret gating POST /entries. Any random long string.
INGEST_API_KEY=generate-a-long-random-string

# Stripe Checkout (subscription mode). success_url/cancel_url are hardcoded
# in api/index.js to https://forgepointsignal.com/success and /
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
# Stripe webhook endpoint signing secret (starts with whsec_...).
# Create the webhook at https://dashboard.stripe.com/webhooks pointing to
# https://forgepointsignal.com/webhook, subscribe to:
#   checkout.session.completed, customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# HMAC key for the magic-link session cookie. 32+ random chars.
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: overrides the base URL used when constructing the magic-link
# redirect URL. Defaults to https://forgepointsignal.com.
APP_URL=https://forgepointsignal.com

# Used by scripts/ingest.js to call the API
FORGEPOINT_API_URL=http://localhost:3000
ANTHROPIC_API_KEY=sk-ant-...
# Optional override (default 30)
LOOKBACK_DAYS=30
