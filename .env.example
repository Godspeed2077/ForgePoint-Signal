SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Required for POST /entries to bypass RLS. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=3000

# Shared secret gating POST /entries. Any random long string.
INGEST_API_KEY=generate-a-long-random-string

# Stripe Payment Link URL — both Subscribe and Get Full Access buttons link here.
STRIPE_CHECKOUT_URL=https://buy.stripe.com/your-payment-link

# Used by scripts/ingest.js to call the API
FORGEPOINT_API_URL=http://localhost:3000
ANTHROPIC_API_KEY=sk-ant-...
# Optional override (default 30)
LOOKBACK_DAYS=30
